# Normalise to LF in the repository regardless of the checkout platform.
# Without this, working on Windows rewrites every file's line endings and
# produces diffs that hide the real changes.
* text=auto eol=lf

# Binary assets: never touch.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
