# ---------------------------------------------------------------------------
# Service request email delivery
#
# Without these, the request form still works in `next dev` (submissions are
# logged to the terminal instead of sent) but WILL RETURN AN ERROR in
# production rather than silently dropping a lead.
#
# Setup, once:
#   1. Create a free account at https://resend.com
#   2. Add and verify the site's domain under Domains
#   3. Create an API key under API Keys
# ---------------------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain verified in Resend.
RESEND_FROM="FMA Industries <service@fmaindustries.com>"
